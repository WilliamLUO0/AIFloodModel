#!/bin/bash
# Batch eval_flood.py aggregation (NIWA / PBS). Structure mirrors the NeSI
# eval_flood_batch.sh exactly (explicit per-line jobs: each line pins WHICH model
# reads WHICH dataset); only the cluster paths, the _pbs result suffix and the
# _niwa.csv index names differ. Assembles saved per-patch predictions into GLOBAL
# / patch_mean metrics. PREREQUISITE: the matching test_flood_map jobs
# (options/test/<exp>_eval_*_pbs.*) must already have written predictions under
# results/<evalname>_pbs/visualization/. Jobs with no vis-root are skipped.
# Submit:  qsub tools/eval_flood_batch.pbs
# NOTE: eval_flood.py aggregation is CPU-only (torch on CPU only for the
# coarse_upsample baseline). We request 1 GPU on a100q merely to guarantee a node;
# switch to a CPU queue here if NIWA provides one.
#PBS -q shortq
#PBS -l select=1:ncpus=4:mem=48GB
#PBS -l walltime=48:00:00
#PBS -N eval_flood_batch_pbs
#PBS -S /bin/bash
#PBS -o /esi/project/niwa04345/luoz/AIFloodModel/logs/
#PBS -e /esi/project/niwa04345/luoz/AIFloodModel/logs/
#PBS -m abe
#PBS -M williamlzh00@gmail.com

set -euo pipefail

mkdir -p /esi/project/niwa04345/luoz/AIFloodModel/logs
cd /esi/project/niwa04345/luoz/AIFloodModel

. $(ls /opt/niwa/profile/spack_* | tail -1)
spack load cuda@12.8.0
spack load gcc@12.2.0

. $(ls /opt/niwa/profile/conda_* | tail -1)
set +u
conda activate /esi/project/niwa04345/luoz/envs/pft39
set -u

export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4
export PYTHONUNBUFFERED=1

# ===================== cluster paths (NIWA) =====================
ROOT=/esi/project/niwa04345/luoz/AIFloodModel
SUF="_pbs"                                    # NIWA eval-result dirs carry the _pbs suffix
RESULTS=$ROOT/results
BOUT="$RESULTS/_baselines"

# Variable to aggregate: h (water depth), u or v (x/y water velocity). For u/v the
# eval classifies wet/dry & bands by |v| (--abs) and the experiment / val-index names
# carry the _u / _v suffix. VAR=h reproduces the original behaviour exactly.
# Experiment names in the job lists below are BASE (h) names; $EXPSUF is appended
# automatically. Only 01 has u/v checkpoints -- 02/03/04/05/06 are h-only, so for
# VAR=u/v they self-skip (no _u/_v vis-root); comment them out to keep the log clean.
VAR=h                                         # <-- set to h / u / v
if [[ "$VAR" == "h" ]]; then EXPSUF=""; ABS=""; else EXPSUF="_${VAR}"; ABS="--abs"; fi

TRAIN_INDEX=index_with_interval_stats_${VAR}_niwa.csv  # val index (per training dataset)
TEST_INDEX=index_niwa.csv                              # test-dataset index (all vars)

# split JSON of a training dataset (for the val completeness guard, review 2026-10-14 A1)
if [[ "$VAR" == "h" ]]; then SPLIT_JSON_NAME=split_stats_h_asinh.json; else SPLIT_JSON_NAME=split_stats_${VAR}.json; fi
# failed jobs are collected (one failure no longer aborts the batch) and listed at the end -> exit 1
FAILED=()

# ===================== EDIT HERE: explicit eval jobs =====================
# Fully explicit -- each line pins WHICH model reads WHICH dataset. Comment out
# anything already aggregated (you may run this in several batches).
#
# VAL jobs -> "exp_base:train_dataset_dir"  (val patches live in the training
#   dataset; read as *_patch_mean, pinned to the seed-61 val 20% via --vis-root).
VAL_JOBS=(
  # ===== Paper 2 M1 topography-guidance ablation (03/05 rows at 600k; row (a) = 01 at 1M, user 2026-10-17;
  #       val + 100y_42h only) =====
  # "01_FMPFTV8_SRx8_Filter_InbaL1BCE_LW:dataset_ds8_filtered_thr0p1_min5100_full"
  # "01_FMPFTV8_SRx8_Filter_InbaL1BCE_LW_seed1202:dataset_ds8_filtered_thr0p1_min5100_full"   # M1 row (a) seed replicates (1M; mean +- std)
  # "01_FMPFTV8_SRx8_Filter_InbaL1BCE_LW_seed2027:dataset_ds8_filtered_thr0p1_min5100_full"
  # "01_FMPFTV8_SRx8_Filter_InbaL1BCE_LW_seed1983:dataset_ds8_filtered_thr0p1_min5100_full"
