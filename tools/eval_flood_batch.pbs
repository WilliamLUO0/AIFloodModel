  # "08_FloodDM_SRx8_Filter_EpsL1:test100y42h0c_400k:testdataset_100y42h0c"   # Flood-DM at their 400k budget (SI)
)

# Paper 2 S4/S5: per-cell TRAINING max-depth maps (tools/make_train_maxdepth.sh, NeSI -> copy the .npz here;
# fine target side + coarse input side, 18 scenarios x 48 steps). For the eval tags listed, model AND baseline evals
# add 'beyond_train_max' (extrapolation fraction, > max + 0.1 m, pooled + peak hour).
# A listed tag whose map is missing is SKIPPED with an error line (never silently evaluated without it).
TRAINMAX_NPZ="$ROOT/dataset_ds8_filtered_thr0p1_min5100_full/train_maxdepth_h.npz"
TRAINMAX_TAGS=(
  "test1000y48h0cx1p25"
  "test1000y48h0cx1p5"
  "test1000y48h0cx2p0"
  "test1000y48h0cx3p0"
  "test100y48h0cdp11"           # S5: expected ~0 (no magnitude extrapolation) -> evidence S5 tests the pattern only
  "test100y48h0cdp21"
  "test1000y48h0c"              # seen scenarios: exactly 0 by construction (sanity check of the maps)
  "test100y48h0c"
  # "test1000y42h0c"            # unseen refs: meaningful, BUT these tags are also used by M1/M2/S2/... blocks ->
  # "test100y42h0c"             # listing them makes those evals require the map too (skipped if it is missing)
)
# The two UNSEEN references are the x = 1 columns of the S4/S5 plots, so they need the extrapolation fraction too --
# but only for the 01 1M row (and the model-independent bicubic row), not for every M1/M2/S2 eval on those sets.
# Entries are "<exp base without EXPSUF>:<tag>"; "baseline:<tag>" selects the bicubic row.
# UNCOMMENT together with the S4/S5 blocks (needs TRAINMAX_NPZ on this machine). While M1/M2/S2/... are being
# aggregated, "baseline:test100y42h0c" would otherwise make their shared 100y bicubic baseline require the map
# and fail without it (Code side, 2026-10-17).
TRAINMAX_EXP_TAGS=(
  "01_FMPFTV8_SRx8_Filter_InbaL1BCE_LW:test1000y42h0c"
  "01_FMPFTV8_SRx8_Filter_InbaL1BCE_LW:test100y42h0c"
  "baseline:test1000y42h0c"
  "baseline:test100y42h0c"
)

# coarse-upsample baselines (bicubic upsample of the coarse map). MODEL-INDEPENDENT
# -> ONE per FACTOR (ds2/4/8/16); the loops dedup by output name. List ONE selector
# per factor. Output naming is keyed by FACTOR, not by dataset dir:
#   eval_val_baseline_<dsN>{EXPSUF}.json / eval_<tag>_baseline_<dsN>{EXPSUF}.json
# so the ds8 val baseline is computed on the FILTERED ds8 only -- the unfiltered
# dataset_ds8 (noFilter ablation) maps to the SAME file name and would overwrite it.
# RUN_BASELINES  : master switch (0 = skip the whole section).
# FORCE_BASELINES: 0 = auto-skip any baseline whose output json already exists in
#                  results/_baselines/ (leave the lists complete and just resubmit);
#                  1 = recompute and overwrite existing outputs.
# DRY_RUN=1: print the ACTIVE job lists (+ whether each vis-root / index exists) and exit without evaluating.
# Recommended before every submission: there are many commented M1..S5 blocks -- open ONE block at a time,
# `bash -n` this file, then run it once with DRY_RUN=1 (e.g. `bash tools/eval_flood_batch.pbs` on the login node),
# set DRY_RUN=0 and qsub.
# PART (2026-10-28): split one big aggregation into two PBS jobs that run in parallel (outputs never overlap).
#   all  = everything active below;  val = VAL_JOBS + VAL_BASELINE_JOBS only;  test = TEST_JOBS + TEST_BASELINE_JOBS only.
#   Set PART=val -> qsub, then PART=test -> qsub again (PBS copies the script at qsub time).
PART=all
DRY_RUN=0
RUN_BASELINES=1
FORCE_BASELINES=1   # Paper 2: recompute ds8 val + 100y baselines so they carry PSNR/SSIM
# VAL baseline -> "selector_exp_base:train_dataset_dir" (selector's val vis pins the subset)
VAL_BASELINE_JOBS=(
  # "01_FMPFTV8_SRx8_Filter_InbaL1BCE_LW:dataset_ds8_filtered_thr0p1_min5100_full"   # Paper 2 M1 (selector only pins the val patch set; same set for every s=8 run)
  # "06_FMPFTV8_SRx2_Filter_InbaL1BCE_LW:dataset_ds2_filtered_thr0p1_min25100_full"
  # "06_FMPFTV8_SRx4_Filter_InbaL1BCE_LW:dataset_ds4_filtered_thr0p1_min10100_full"
  # "06_FMPFTV8_SRx16_Filter_InbaL1BCE_LW:dataset_ds16_filtered_thr0p1_min2100_full"
  # --- Paper 2 M3 (uncomment with the M3 block; Row B outputs carry _pf512) ---
  # "06_FMPFTV8_SRx2_PF512_Filter_InbaL1BCE_LW:dataset_ds2_pf512_filtered_thr0p1_min25100_full"
  "06_FMPFTV8_SRx4_PF512_Filter_InbaL1BCE_LW:dataset_ds4_pf512_filtered_thr0p1_min10100_full"
  "06_FMPFTV8_SRx16_PF512_Filter_InbaL1BCE_LW:dataset_ds16_pf512_filtered_thr0p1_min2100_full"
  "06_FMPFTV8_SRx2_Filter_InbaL1BCE_LW:dataset_ds2_filtered_thr0p1_min25100_full"
  "06_FMPFTV8_SRx4_Filter_InbaL1BCE_LW:dataset_ds4_filtered_thr0p1_min10100_full"
  "06_FMPFTV8_SRx16_Filter_InbaL1BCE_LW:dataset_ds16_filtered_thr0p1_min2100_full"
)
# TEST baseline -> "eval_tag:test_dataset_dir"
TEST_BASELINE_JOBS=(
  # "test2y42h0c:testdataset_2y42h0c"
  # "test5y42h0c:testdataset_5y42h0c"
  # "test10y42h0c:testdataset_10y42h0c"
  # "test50y42h0c:testdataset_50y42h0c"
  "test100y42h0c:testdataset_100y42h0c"   # Paper 2 M1
  # "test100y42h0c:testdataset_100y42h0c"
  "test1000y42h0c:testdataset_1000y42h0c"
  # "gabrielle:testdataset_gabrielle"
  # "test100y42h0c:testdataset_100y42h0c_ds2"
  # "gabrielle:testdataset_gabrielle_ds2"
  # "test100y42h0c:testdataset_100y42h0c_ds4"
  # "gabrielle:testdataset_gabrielle_ds4"
  # "test100y42h0c:testdataset_100y42h0c_ds16"
  # "gabrielle:testdataset_gabrielle_ds16"
  # --- Paper 2 M3 (uncomment with the M3 block) ---
  # "test100y42h0c:testdataset_100y42h0c_ds2_pf512"
  "test100y42h0c:testdataset_100y42h0c_ds4_pf512"
  "test100y42h0c:testdataset_100y42h0c_ds16_pf512"
  "test100y42h0c:testdataset_100y42h0c_ds2"
  "test100y42h0c:testdataset_100y42h0c_ds4"
  "test100y42h0c:testdataset_100y42h0c_ds16"
  # --- Paper 2 S3(a) (uncomment with the S3 block; bicubic of the coarse map onto the 16 m grid) ---
  "test100y42h0c_xres16:testdataset_100y42h0c_xres16_ds8"
  "test100y42h0c_xres16:testdataset_100y42h0c_xres16_ds4"
  # "test100y42h0c_xres16:testdataset_100y42h0c_xres16_ds2"
  # --- Paper 2 S4 (uncomment with the S4 block; bicubic of the dx64 map onto the 8 m grid) ---
  "test1000y48h0cx1p25:testdataset_1000y48h0cx1p25"
  "test1000y48h0cx1p5:testdataset_1000y48h0cx1p5"
  "test1000y48h0cx2p0:testdataset_1000y48h0cx2p0"
  "test1000y48h0cx3p0:testdataset_1000y48h0cx3p0"     # OPTIONAL
  "test1000y48h0c:testdataset_1000y48h0c"             # x1, seen scenario
  # --- Paper 2 S5 (uncomment with the S5 block) ---
  "test100y48h0cdp11:testdataset_100y48h0cdp11"
  "test100y48h0cdp21:testdataset_100y48h0cdp21"
  "test100y48h0c:testdataset_100y48h0c"               # single peak, seen scenario
)
# =======================================================================

# dataset dir (dataset_ds8_..._full or testdataset_..._ds16) -> factor tag ds2/4/8/16.
factor_tag () {
  # Paper 2 M3 Row B dirs (fine patch 512) carry "_pf512" -> tag dsN_pf512, so their baselines
  # never overwrite the Row A (coarse 64) baseline files of the same factor.
  local pf=""
  case "$1" in *_pf512*) pf="_pf512" ;; esac
  case "$1" in
    *ds2_*|*_ds2)   echo "ds2${pf}"  ;;
    *ds4_*|*_ds4)   echo "ds4${pf}"  ;;
    *ds16_*|*_ds16) echo "ds16${pf}" ;;
    *)              echo ds8  ;;   # factor-8 test dirs have no suffix; ds8 training dir
  esac
}

# ---- model eval on VAL (read *_patch_mean; --vis-root pins the val 20% subset) ----
eval_val () {
  local exp="$1" ds="$2"
  local idx="$ROOT/$ds/$TRAIN_INDEX"
  local vis="$RESULTS/${exp}_eval_val${SUF}/visualization"
  local out="$RESULTS/${exp}_eval_val${SUF}"
  if [[ ! -d "$vis" ]]; then echo "[skip][val] no vis-root: $vis"; return; fi
  echo "[eval][val] $exp  (ds=$ds)"
  python tools/eval_flood.py \
    --index-csv "$idx" \
    --vis-root  "$vis" \
    --var "$VAR" $ABS \
    --out-json  "$out/eval_val_summary.json" \
    --out-csv-patch    "$out/eval_val_patch.csv" \
    --out-csv-time     "$out/eval_val_time.csv" \
    --out-csv-scenario "$out/eval_val_scenario.csv" \
    --require-complete val --split-json "$ROOT/$ds/$SPLIT_JSON_NAME" \
    || { echo "[FAILED][val] $exp"; FAILED+=("$exp:val"); return 0; }
}

# ---- model eval on a TEST set (read *_global; complete maps) ----
# prints the extra eval_flood.py args for a tag ("" if not a TRAINMAX tag); returns 1 if the map is missing.
# $1 = tag (matched against TRAINMAX_TAGS), $2 = "<exp base>:<tag>" (matched against TRAINMAX_EXP_TAGS; optional)
tmax_args () {
  local t hit=0
  for t in "${TRAINMAX_TAGS[@]}"; do [[ "$t" == "$1" ]] && hit=1; done
  if [[ -n "${2:-}" ]]; then for t in ${TRAINMAX_EXP_TAGS[@]+"${TRAINMAX_EXP_TAGS[@]}"}; do [[ "$t" == "$2" ]] && hit=1; done; fi
  if (( hit == 0 )); then return 0; fi
  if [[ "$VAR" != "h" ]]; then return 0; fi
  if [[ ! -f "$TRAINMAX_NPZ" ]]; then echo "[error][$1] TRAINMAX_NPZ missing: $TRAINMAX_NPZ" >&2; return 1; fi
  echo "--train-maxdepth-npz $TRAINMAX_NPZ"; return 0
}

eval_one_test () {
  local exp="$1" tag="$2" dsdir="$3"
  local idx="$ROOT/$dsdir/$TEST_INDEX"
  local vis="$RESULTS/${exp}_eval_${tag}${SUF}/visualization"
  local out="$RESULTS/${exp}_eval_${tag}${SUF}"
  if [[ ! -d "$vis" ]]; then echo "[skip][$tag] no vis-root: $vis"; return; fi
  local TMX
  if ! TMX=$(tmax_args "$tag" "${exp%"$EXPSUF"}:$tag"); then
    echo "[skip][$tag] $exp: train-max map missing"; FAILED+=("$exp:$tag:train-max-map-missing"); return
  fi
  echo "[eval][$tag] $exp  (ds=$dsdir) ${TMX}"
  python tools/eval_flood.py \
    --index-csv "$idx" \
    --vis-root  "$vis" \
    --var "$VAR" $ABS $TMX \
    --out-json  "$out/eval_${tag}_summary.json" \
    --out-csv-time     "$out/eval_${tag}_time.csv" \
    --out-csv-scenario "$out/eval_${tag}_scenario.csv" \
    --require-complete test \
    || { echo "[FAILED][$tag] $exp"; FAILED+=("$exp:$tag"); return 0; }
}

case "$PART" in all|val|test) ;; *) echo "[error] PART must be all / val / test (got $PART)" >&2; exit 1 ;; esac
if [[ "$PART" == "test" ]]; then VAL_JOBS=(); VAL_BASELINE_JOBS=(); fi
if [[ "$PART" == "val" ]]; then TEST_JOBS=(); TEST_BASELINE_JOBS=(); fi

if [[ "$DRY_RUN" == "1" ]]; then
  echo "==================== DRY RUN (nothing is evaluated) ===================="
  echo "VAR=$VAR  PART=$PART  RUN_BASELINES=$RUN_BASELINES  FORCE_BASELINES=$FORCE_BASELINES"
  echo "--- VAL_JOBS (${#VAL_JOBS[@]})"
  for job in ${VAL_JOBS[@]+"${VAL_JOBS[@]}"}; do
    e="${job%%:*}${EXPSUF}"; v="$RESULTS/${e}_eval_val${SUF}/visualization"
    printf '  %-70s %s\n' "$e" "$([[ -d "$v" ]] && echo 'vis OK' || echo 'vis MISSING')"
  done
  echo "--- TEST_JOBS (${#TEST_JOBS[@]})"
  for job in ${TEST_JOBS[@]+"${TEST_JOBS[@]}"}; do
    IFS=":" read -r eb tg ds <<< "$job"; e="${eb}${EXPSUF}"; v="$RESULTS/${e}_eval_${tg}${SUF}/visualization"
    tm=""; if TMX=$(tmax_args "$tg" "$eb:$tg" 2>/dev/null); then [[ -n "$TMX" ]] && tm=" +train-max"; else tm=" train-max MAP MISSING"; fi
    printf '  %-60s %-24s %s%s\n' "$e" "$tg" "$([[ -d "$v" ]] && echo 'vis OK' || echo 'vis MISSING')" "$tm"
  done
  if [[ "$RUN_BASELINES" == "1" ]]; then
    echo "--- VAL_BASELINE_JOBS (${#VAL_BASELINE_JOBS[@]})"; for job in ${VAL_BASELINE_JOBS[@]+"${VAL_BASELINE_JOBS[@]}"}; do echo "  $job"; done
    echo "--- TEST_BASELINE_JOBS (${#TEST_BASELINE_JOBS[@]})"
    for job in ${TEST_BASELINE_JOBS[@]+"${TEST_BASELINE_JOBS[@]}"}; do
      IFS=":" read -r tg ds <<< "$job"
      printf '  %-24s %-40s %s\n' "$tg" "$ds" "$([[ -f "$ROOT/$ds/$TEST_INDEX" ]] && echo 'index OK' || echo 'index MISSING')"
    done
  fi
  exit 0
fi

echo "==================== MODEL EVALS (PART=$PART) ===================="
for job in ${VAL_JOBS[@]+"${VAL_JOBS[@]}"}; do
  eval_val "${job%%:*}${EXPSUF}" "${job#*:}"
done
for job in ${TEST_JOBS[@]+"${TEST_JOBS[@]}"}; do
  IFS=":" read -r ebase tag dsdir <<< "$job"
  eval_one_test "${ebase}${EXPSUF}" "$tag" "$dsdir"
done

# ==================== BASELINES (model-independent; explicit lists) ====================
if [[ "$RUN_BASELINES" == "1" ]]; then
  mkdir -p "$BOUT"
  echo "==================== VAL BASELINES ===================="
  declare -A _VBASE_DONE=()
  for job in ${VAL_BASELINE_JOBS[@]+"${VAL_BASELINE_JOBS[@]}"}; do
    ebase="${job%%:*}"; ds="${job#*:}"
    dstag=$(factor_tag "$ds")
    if [[ -n "${_VBASE_DONE[$dstag]:-}" ]]; then continue; fi   # dedup by OUTPUT name (factor)
    outfile="$BOUT/eval_val_baseline_${dstag}${EXPSUF}.json"
    if [[ "$FORCE_BASELINES" != "1" && -f "$outfile" ]]; then
      echo "[skip][baseline][val] already exists: $outfile"; continue
    fi
    selvis="$RESULTS/${ebase}${EXPSUF}_eval_val${SUF}/visualization"
    if [[ ! -d "$selvis" ]]; then
      echo "[skip][baseline][val] no val vis-root for selector ${ebase}${EXPSUF} ($ds)"; continue
    fi
    _VBASE_DONE[$dstag]=1
    echo "[baseline][val] dataset=$ds ($dstag) selector=${ebase}${EXPSUF}"
    python tools/eval_flood.py \
      --index-csv "$ROOT/$ds/$TRAIN_INDEX" \
      --vis-root  "$selvis" \
      --var "$VAR" $ABS \
      --pred-source coarse_upsample \
      --out-json "$outfile" \
      --require-complete val --split-json "$ROOT/$ds/$SPLIT_JSON_NAME" \
      || { echo "[FAILED][baseline][val] $ds"; FAILED+=("baseline:val:$ds"); continue; }
  done

  echo "==================== TEST BASELINES ===================="
  declare -A _TBASE_DONE=()
  for job in ${TEST_BASELINE_JOBS[@]+"${TEST_BASELINE_JOBS[@]}"}; do
    IFS=":" read -r tag dsdir <<< "$job"
    dstag=$(factor_tag "$dsdir")
    if [[ -n "${_TBASE_DONE[${tag}_${dstag}]:-}" ]]; then continue; fi   # dedup by OUTPUT name
    outfile="$BOUT/eval_${tag}_baseline_${dstag}${EXPSUF}.json"
    if [[ "$FORCE_BASELINES" != "1" && -f "$outfile" ]]; then
      echo "[skip][baseline][$tag] already exists: $outfile"; continue
    fi
    idx="$ROOT/$dsdir/$TEST_INDEX"
    if [[ ! -f "$idx" ]]; then echo "[skip][baseline][$tag] no index: $idx"; continue; fi
    _TBASE_DONE[${tag}_${dstag}]=1
    if ! TMX=$(tmax_args "$tag" "baseline:$tag"); then
      echo "[skip][baseline][$tag] train-max map missing"; FAILED+=("baseline:$tag:$dsdir:train-max-map-missing"); continue
    fi
    echo "[baseline][$tag] dataset=$dsdir ($dstag) ${TMX}"
    python tools/eval_flood.py \
      --index-csv "$idx" \
      --var "$VAR" $ABS $TMX \
      --pred-source coarse_upsample \
      --out-json "$outfile" \
      --out-csv-time "${outfile%.json}_time.csv" \
      --require-complete test \
      || { echo "[FAILED][baseline][$tag] $dsdir"; FAILED+=("baseline:$tag:$dsdir"); continue; }
  done
fi

if (( ${#FAILED[@]} > 0 )); then
  echo "==================== ${#FAILED[@]} JOB(S) FAILED (incomplete / unreadable predictions -> rerun inference; or train-max map missing) ===================="
  for f in "${FAILED[@]}"; do echo "  $f"; done
  exit 1
fi
echo "==================== DONE ===================="
