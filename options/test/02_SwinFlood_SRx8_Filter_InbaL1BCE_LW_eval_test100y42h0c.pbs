#!/bin/bash
#PBS -q a100q
#PBS -l select=1:ncpus=4:ngpus=1:mem=24GB:nodepool=a100p
#PBS -l walltime=6:00:00
#PBS -N eval_02_SwinFlood_SRx8_Filter_InbaL1BCE_LW_eval_test100y42h0c_pbs
#PBS -S /bin/bash
#PBS -o /esi/project/niwa04345/luoz/AIFloodModel/logs/
#PBS -e /esi/project/niwa04345/luoz/AIFloodModel/logs/
#PBS -m abe
#PBS -M williamlzh00@gmail.com

set -euo pipefail

mkdir -p /esi/project/niwa04345/luoz/AIFloodModel/logs

cd /esi/project/niwa04345/luoz/AIFloodModel

. $(ls /opt/niwa/profile/spack_* | tail -1)
spack load cuda@12.8.0
spack load gcc@12.2.0

. $(ls /opt/niwa/profile/conda_* | tail -1)
set +u
conda activate /esi/project/niwa04345/luoz/envs/pft39
set -u

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export TORCH_NUM_THREADS=1
export PYTHONUNBUFFERED=1

nvidia-smi

torchrun --nproc_per_node=1 --standalone basicsr/test_flood_map.py -opt options/test/02_SwinFlood_SRx8_Filter_InbaL1BCE_LW_eval_test100y42h0c_pbs.yml --launcher pytorch
